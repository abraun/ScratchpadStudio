#!/usr/bin/env python3
"""scratchpad-studio — engine helper for the Scratchpad Studio Omarchy plugin.

Everything the GUI cannot do from QML lives here: reading Hyprland state,
computing window geometry, launching apps, toggling special workspaces, and
generating the managed Hyprland config (persistent rules + keybinds).

Stdlib only. No network. Never closes or kills the user's windows.

Usage: scratchpad-studio <command> [args]
  list                    print scratchpads + live status as JSON
  toggle <id>             show/hide a scratchpad, launching missing apps
  show <id> / hide <id>   reveal or hide without toggling
  geometry <id>           print computed window rects (debug)
  shown                   print revealed special ids as JSON
  apply                   regenerate Hyprland config from state + reload
  reflow <id>             move live scratchpad windows to their slot rects
  delete <id> [--keep]    remove scratchpad (windows move to current ws)
  adopt <id> [--name N]   take over an existing special workspace
  capture <id>            move the focused window (or --class C /
                          --address A) into the scratchpad and add its
                          class - bindable as 'send window to <id>'
  eject                   move the focused scratchpad window to the
                          current workspace and stop re-summoning it
  install / uninstall     wire in / cleanly remove the managed config
  state-path              print the state file path
  version                 print the plugin version
"""

from __future__ import annotations

import datetime
import json
import os
import shlex
import shutil
import subprocess
import sys
import time
from pathlib import Path

HOME = Path(os.environ.get("HOME", str(Path.home())))
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
STATE_DIR = CONFIG_DIR / "scratchpad-studio"
STATE_PATH = STATE_DIR / "scratchpads.json"
BACKUP_DIR = STATE_DIR / "backups"
HYPR_DIR = CONFIG_DIR / "hypr"
GENERATED_LUA = HYPR_DIR / "scratchpad-studio.lua"
BINDINGS_LUA = HYPR_DIR / "bindings.lua"

BLOCK_BEGIN = "-- >>> scratchpad-studio (managed) >>>"
BLOCK_END = "-- <<< scratchpad-studio (managed) <<<"
BLOCK_LINES = [BLOCK_BEGIN, 'require("hypr.scratchpad-studio")', BLOCK_END]

GAP_MIN_PX = 6
VERSION = "0.2.0"

# Omarchy's built-in scratchpad special (its SUPER+S "Toggle scratchpad"
# bind targets special:scratchpad). A plugin scratchpad with this id would
# share that workspace: both chords would toggle the same special and the
# built-in's windows would leak into ours — reserved, never assigned.
RESERVED_SPECIALS = ("scratchpad",)

ANCHORS = ("top", "bottom", "left", "right", "center")
LAYOUTS = ("single", "pair", "stacked", "three-up", "grid", "wide-left", "wide-right")
# "popin" pairs with the center anchor: the frame has no edge to slide
# from, so windows scale in instead (Hyprland's popin animation style).
TRANSITIONS = ("down", "up", "right", "left", "popin")
# Windows either open arranged in the configured slot geometry ("slots",
# float + baked pixel rules — the default since v0.1) or free-floating
# ("floating": float, no size/move rules, the window keeps its own size).
PLACEMENTS = ("slots", "floating")

# Apps known to be single-instance: the launcher process exits immediately
# and the real window maps later, so PID/process tracking always lies. For
# these we match by window class only. (Cider gotcha from the brief.)
SINGLE_INSTANCE_CLASSES = {
    "cider", "spotube", "youtube-music", "webcord", "discord", "slack",
    "1password", "bitwarden", "signal", "telegramdesktop", "whatsapp",
}

SINGLE_INSTANCE_BINARIES = {
    "cider", "spotube", "youtube-music", "webcord", "discord", "slack",
    "1password", "bitwarden", "signal", "telegram-desktop", "whatsapp",
    "spotify", "steam", "obs", "zoom", "teams", "thunderbird",
}


# ------------------------------------------------------- app catalogue

def _parse_desktop_file(path: Path) -> dict | None:
    entry: dict = {}
    section = None
    try:
        for raw in path.read_text(errors="replace").splitlines():
            line = raw.strip()
            if line.startswith("[") and line.endswith("]"):
                section = line[1:-1]
                continue
            if section != "Desktop Entry" or "=" not in line:
                continue
            key, _, value = line.partition("=")
            entry[key.strip()] = value.strip()
    except OSError:
        return None
    if entry.get("Type") != "Application" or not entry.get("Exec"):
        return None
    if entry.get("NoDisplay", "").lower() in ("true", "1"):
        return None
    return entry


def _exec_binary(exec_line: str) -> str:
    """First non-flag token of an Exec line, field codes stripped."""
    tokens = [t for t in exec_line.replace("%f", "").replace("%F", "")
              .replace("%u", "").replace("%U", "").replace("%d", "")
              .replace("%D", "").replace("%n", "").replace("%N", "")
              .replace("%i", "").replace("%c", "").replace("%k", "")
              .replace("%v", "").split() if not t.startswith("-")]
    return tokens[0].split("/")[-1] if tokens else ""


def _webapp_host(url: str) -> str:
    host = url.split("//", 1)[-1].split("/", 1)[0]
    return host[4:] if host.startswith("www.") else host


def webapp_class(url: str) -> str:
    host = _webapp_host(url)
    return f"chrome-{host}__-Default"


def app_catalogue() -> list:
    """Installed apps from .desktop files, merged across system, Omarchy's
    webapps, and the user's local entries. Later dirs win by id."""
    dirs = [
        Path("/usr/share/applications"),
        Path("/usr/share/omarchy/applications"),
        Path(os.environ.get("XDG_DATA_HOME", str(HOME / ".local/share"))) / "applications",
    ]
    by_id: dict = {}
    for directory in dirs:
        if not directory.is_dir():
            continue
        for path in sorted(directory.glob("*.desktop")):
            entry = _parse_desktop_file(path)
            if entry is None:
                continue
            exec_line = entry.get("Exec", "")
            webapp = exec_line.startswith("omarchy-launch-webapp")
            url = ""
            if webapp and len(exec_line.split()) > 1:
                url = exec_line.split()[1].strip('\"\'')
            binary = _exec_binary(exec_line)
            if webapp:
                wm_class = webapp_class(url)
            else:
                wm_class = entry.get("StartupWMClass") or binary
            single = (
                not webapp
                and (wm_class.lower() in SINGLE_INSTANCE_CLASSES
                     or binary.lower() in SINGLE_INSTANCE_BINARIES)
            )
            by_id[path.stem] = {
                "id": path.stem,
                "name": entry.get("Name") or path.stem,
                "icon": entry.get("Icon") or "",
                "exec": exec_line,
                "command": exec_line if webapp else " ".join(
                    t for t in exec_line.split() if not t.startswith("%")
                ),
                "wmClass": wm_class,
                "webapp": webapp,
                "url": url,
                "singleInstance": single,
                "comment": entry.get("Comment") or entry.get("GenericName") or "",
            }
    apps = sorted(by_id.values(), key=lambda a: a["name"].lower())
    return apps


def cmd_apps() -> None:
    print(json.dumps(app_catalogue(), indent=2))


def cmd_upsert(argv: list[str]) -> None:
    """Merge one scratchpad (JSON on stdin) into state, save, apply.

    Editing is this command: apps that were removed get their live windows
    relocated to the current workspace (never killed), and windows already
    open on the scratchpad are reflowed onto their new slots — otherwise
    window rules (which only fire at map time) would leave stale geometry
    on screen until every app was restarted."""
    try:
        raw = json.loads(sys.stdin.read())
    except json.JSONDecodeError as error:
        die(f"stdin is not valid JSON: {error}")
    sp = normalize_sp(raw)
    state = load_state()
    old = find_sp(state, sp["id"])
    if old is None:
        # New scratchpad: never let it share a special workspace with
        # another entry or the Omarchy built-in (two chords toggling the
        # same windows). The GUI already assigns free ids; this guards
        # direct CLI use.
        sp["id"] = unique_id(sp["id"], [s["id"] for s in state["scratchpads"]])
    # Same for chords: two scratchpads on one chord means one bind toggles
    # two scratchpads. The GUI blocks this before saving; the guard here
    # covers direct CLI use (--allow-conflicts for scripted migrations).
    if sp["keybind"] and "--allow-conflicts" not in argv:
        owners = scratchpad_chord_owners(state, sp["keybind"], sp["id"])
        if owners:
            die(f"chord {sp['keybind']} already belongs to scratchpad "
                f"'{owners[0]['name']}' — pick another (or pass --allow-conflicts)")
    gone = removed_classes(old, sp) if old else []
    kept = [s for s in state["scratchpads"] if s["id"] != sp["id"]]
    kept.append(sp)
    kept.sort(key=lambda s: s["name"].lower())
    state["scratchpads"] = kept
    save_state(state)
    apply(quiet=True)
    for cls in gone:
        move_class_out(sp["id"], cls)
    reflow(sp["id"], quiet=True)
    print(json.dumps({"id": sp["id"], "removedApps": gone}))


def cmd_capture(argv: list[str]) -> None:
    """Move an existing desktop window into a scratchpad (stdin-free).

    Target: the currently focused window, or --class <class> / --address
    <addr> to pick one explicitly. The window is moved onto the scratchpad's
    special workspace (silent - follow=false, the movetoworkspacesilent
    semantic), its class is added to the app list if new (with launch info
    and single-instance detection from the app catalogue), config is
    regenerated (so future windows of the class route here) and the
    captured window is reflowed into its slot. Never closes or kills
    anything; --allow-conflicts overrides the class-ownership guard."""
    sp_id = argv[2]
    cls_flag = flag_value(argv, "--class")
    address_flag = flag_value(argv, "--address")
    state = load_state()
    sp = find_sp(state, sp_id)
    if sp is None:
        die(f"unknown scratchpad: {sp_id}")
    clients_list = clients()
    try:
        focused = hyprctl_json(["-j", "activewindow"])
    except (SystemExit, json.JSONDecodeError, ValueError):
        focused = None
    target, reason = select_capture_target(
        clients_list, focused, address_flag, cls_flag)
    if target is None:
        die(reason)
    cls = str(target.get("class") or "")
    owner = class_owned_by_other(state, cls, sp["id"])
    if owner is not None and "--allow-conflicts" not in argv:
        die(f"class {cls} already belongs to scratchpad '{owner['name']}' - "
            "capture would route that class two ways (or pass --allow-conflicts)")
    address = str(target.get("address") or "")
    dispatch_lua(
        f'hl.dsp.window.move({{ window = {lua_quote("address:" + address)}, '
        f'workspace = {lua_quote("special:" + sp["id"])} , follow = false }})'
    )
    app_added = False
    if cls and all(app["class"] != cls for app in sp["apps"]):
        sp["apps"].append(build_captured_app(target, app_catalogue()))
        app_added = True
        save_state(state)
        apply(quiet=True)
    reflow(sp_id, quiet=True)
    print(json.dumps({
        "captured": address,
        "class": cls,
        "appAdded": app_added,
        "workspace": f"special:{sp['id']}",
    }))


def die(message: str, code: int = 1) -> None:
    print(f"scratchpad-studio: {message}", file=sys.stderr)
    sys.exit(code)


# ---------------------------------------------------------------- hyprctl

def hyprctl(args: list[str], check: bool = True) -> str:
    result = subprocess.run(
        ["hyprctl"] + args, capture_output=True, text=True, timeout=10
    )
    if check and result.returncode != 0:
        die(f"hyprctl {' '.join(args)} failed: {result.stderr.strip()}")
    return result.stdout


def hyprctl_json(args: list[str]):
    # Callers may pass "-j" themselves (most do); don't duplicate it.
    return json.loads(hyprctl(args if args and args[0] == "-j" else ["-j"] + args))


def eval_lua(code: str) -> None:
    """Run a Lua snippet in Hyprland. Dies with the compositor's error.

    Note: code run through `eval` has NO keybind/input context — workspace
    dispatchers like toggle_special silently no-op there (verified live).
    Anything that acts on the focused monitor must go through dispatch_lua.
    """
    result = subprocess.run(
        ["hyprctl", "eval", code], capture_output=True, text=True, timeout=10
    )
    if result.returncode != 0:
        die(f"hyprctl eval failed: {result.stderr.strip()}")


def dispatch_lua(code: str) -> None:
    """Run a Lua dispatcher with keybind context. `hyprctl dispatch` in
    Lua-config mode takes a hl.dsp.* expression as its argument and supplies
    the context that makes toggle_special actually reveal the workspace
    (verified live: eval returns ok but never shows; dispatch works)."""
    result = subprocess.run(
        ["hyprctl", "dispatch", code], capture_output=True, text=True, timeout=10
    )
    if result.returncode != 0:
        die(f"hyprctl dispatch failed: {result.stderr.strip()}")


def lua_quote(text: str) -> str:
    return '"' + text.replace("\\", "\\\\").replace('"', '\\"') + '"'


# ---------------------------------------------------------------- state

def default_state() -> dict:
    return {"version": 1, "scratchpads": []}


def normalize_app(app: dict) -> dict:
    return {
        "name": str(app.get("name") or "App"),
        "command": str(app.get("command") or ""),
        "class": str(app.get("class") or ""),
        "webapp": bool(app.get("webapp")),
        "singleInstance": bool(app.get("singleInstance")),
        # Ejected apps keep their entry but toggle stops re-summoning them
        # until they are captured (or re-enabled) again.
        "detached": bool(app.get("detached")),
    }


def normalize_sp(sp: dict) -> dict:
    size = sp.get("sizePct") or {}
    anchor = sp.get("anchor") if sp.get("anchor") in ANCHORS else "top"
    placement = sp.get("placement") if sp.get("placement") in PLACEMENTS else "slots"
    return {
        "id": slug(sp.get("id") or sp.get("name") or "scratchpad"),
        "name": str(sp.get("name") or "Scratchpad"),
        "icon": str(sp.get("icon") or ""),
        "keybind": str(sp.get("keybind") or ""),
        "anchor": anchor,
        "layout": sp.get("layout") if sp.get("layout") in LAYOUTS else "single",
        "transition": sp.get("transition") if sp.get("transition") in TRANSITIONS else "down",
        "placement": placement,
        "sizePct": {
            "w": clamp(size.get("w", 60), 30, 95),
            "h": clamp(size.get("h", 50), 25, 95),
        },
        "marginPx": int(clamp(sp.get("marginPx", 12), 0, 128)),
        "apps": [normalize_app(a) for a in (sp.get("apps") or [])],
    }


def normalize_state(raw) -> dict:
    state = default_state()
    if isinstance(raw, dict):
        if isinstance(raw.get("version"), int):
            state["version"] = raw["version"]
        if isinstance(raw.get("scratchpads"), list):
            state["scratchpads"] = [normalize_sp(sp) for sp in raw["scratchpads"]]
    return state


def slug(text: str) -> str:
    out = []
    for ch in text.lower():
        out.append(ch if ch.isalnum() else "-")
    slug_text = "".join(out).strip("-")
    while "--" in slug_text:
        slug_text = slug_text.replace("--", "-")
    return (slug_text or "scratchpad")[:32]


def unique_id(candidate: str, taken) -> str:
    """First free id for a NEW scratchpad: `music` -> `music-2` -> `music-3`.
    Reserved names (the Omarchy built-in) and every existing scratchpad id
    count as taken — two scratchpads must never share a special workspace,
    or their chords toggle the same windows."""
    taken = set(taken) | set(RESERVED_SPECIALS)
    base = slug(candidate)
    if base not in taken:
        return base
    n = 2
    while f"{base}-{n}" in taken:
        n += 1
    return f"{base}-{n}"


def clamp(value, lo: int, hi: int) -> int:
    try:
        number = int(round(float(value)))
    except (TypeError, ValueError):
        number = lo
    return max(lo, min(hi, number))


def load_state() -> dict:
    try:
        raw = json.loads(STATE_PATH.read_text())
    except FileNotFoundError:
        return default_state()
    except json.JSONDecodeError as error:
        die(f"state file is not valid JSON ({STATE_PATH}: {error})")
    return normalize_state(raw)


def save_state(state: dict) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = STATE_PATH.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(state, indent=2) + "\n")
    os.replace(tmp, STATE_PATH)


def find_sp(state: dict, sp_id: str) -> dict | None:
    for sp in state["scratchpads"]:
        if sp["id"] == sp_id:
            return sp
    return None


def flag_value(argv: list[str], flag: str) -> str | None:
    """Value following a --flag, or None."""
    if flag in argv:
        i = argv.index(flag)
        if i + 1 < len(argv):
            return argv[i + 1]
    return None


# ---------------------------------------------------------------- live state

def monitors() -> list:
    return hyprctl_json(["-j", "monitors"])


def focused_monitor() -> dict:
    for monitor in monitors():
        if monitor.get("focused"):
            return monitor
    monitors_list = monitors()
    return monitors_list[0] if monitors_list else die("no monitors")


def usable_area(monitor: dict) -> tuple[int, int]:
    # hyprctl reports physical pixels + scale; window coordinates are logical.
    scale = float(monitor.get("scale") or 1) or 1
    return int(monitor["width"] / scale), int(monitor["height"] / scale)


def clients() -> list:
    return hyprctl_json(["-j", "clients"])


def workspaces() -> list:
    return hyprctl_json(["-j", "workspaces"])


def special_is_shown(sp_id: str) -> bool:
    # hyprctl's workspace JSON omits the active flag for special workspaces;
    # the focused monitor's specialWorkspace field is the reliable source
    # (verified live: shows {"id": -97, "name": "special:testpad"} only
    # while the special is revealed on that monitor).
    name = f"special:{sp_id}"
    for monitor in monitors():
        special = monitor.get("specialWorkspace") or {}
        if str(special.get("name") or "") == name and (monitor.get("focused") or monitor == monitors()[0]):
            return True
    return False


def window_classes() -> set[str]:
    return {str(c.get("class") or "") for c in clients() if c.get("mapped", True)}


def classes_on_special(sp_id: str) -> set[str]:
    name = f"special:{sp_id}"
    return {
        str(c.get("class") or "")
        for c in clients()
        if c.get("mapped", True) and str(c.get("workspace", {}).get("name") or "") == name
    }


# ---------------------------------------------------------------- geometry

def base_rect(sp: dict, usable: tuple[int, int]) -> tuple[int, int, int, int]:
    """Anchor rect for the whole scratchpad: (x, y, w, h) in logical px."""
    width, height = usable
    w = max(200, int(width * sp["sizePct"]["w"] / 100))
    h = max(140, int(height * sp["sizePct"]["h"] / 100))
    margin = sp["marginPx"]
    anchor = sp["anchor"]
    if anchor == "top":
        x, y = (width - w) // 2, margin
    elif anchor == "bottom":
        x, y = (width - w) // 2, height - margin - h
    elif anchor == "left":
        x, y = margin, (height - h) // 2
    elif anchor == "right":
        x, y = width - margin - w, (height - h) // 2
    else:  # center
        x, y = (width - w) // 2, (height - h) // 2
    return x, y, w, h


def layout_rects(sp: dict, usable: tuple[int, int]) -> list[tuple[int, int, int, int]]:
    """Per-app rects for the scratchpad's layout. Mirrored in lib/Layout.js;
    python is the source of truth (tests/ cover this copy)."""
    x, y, w, h = base_rect(sp, usable)
    count = max(1, len(sp["apps"]))
    gap = max(GAP_MIN_PX, sp["marginPx"] // 2)
    layout = sp["layout"]

    if layout == "stacked" or count == 1:
        return [(x, y, w, h)] * count

    if layout == "single":
        # Extra apps overlay the first; toggling focus swaps them.
        return [(x, y, w, h)] * count

    if layout in ("wide-left", "wide-right") and count >= 2:
        # One window spans the full height of its half; the rest stack in
        # the other half. wide-left: apps[0] tall on the left. wide-right:
        # apps[-1] tall on the right. With 2 apps this is exactly pair.
        half = (w - gap) // 2
        tall_w = half
        stack_w = w - half - gap
        stack_x = x + w - stack_w if layout == "wide-left" else x
        tall_x = x if layout == "wide-left" else x + w - tall_w
        stack_count = count - 1
        stack_h = (h - gap * (stack_count - 1)) // stack_count
        rects = []
        for index in range(count):
            if layout == "wide-left":
                tall = index == 0
                pos = index - 1          # stack slot, top to bottom
            else:
                tall = index == count - 1
                pos = index              # stack slot, top to bottom
            if tall:
                rects.append((tall_x, y, tall_w, h))
            else:
                rects.append((stack_x, y + pos * (stack_h + gap), stack_w, stack_h))
        return rects

    if layout == "pair":
        if count == 2:
            half = (w - gap) // 2
            return [(x, y, half, h), (x + half + gap, y, w - half - gap, h)]
        columns = 2
    elif layout == "three-up":
        columns = 3
    else:  # grid
        columns = 2

    rows = -(-count // columns)  # ceil
    cell_w = (w - gap * (columns - 1)) // columns
    cell_h = (h - gap * (rows - 1)) // rows
    rects = []
    for index in range(count):
        col = index % columns
        row = index // columns
        rects.append((
            x + col * (cell_w + gap),
            y + row * (cell_h + gap),
            cell_w,
            cell_h,
        ))
    return rects


# ---------------------------------------------------------------- engine

def expected_classes(sp: dict) -> set[str]:
    """Classes this scratchpad may claim at launch: every non-detached app
    with a class. Detached apps were explicitly ejected - toggle must not
    re-summon them until they are captured (or re-enabled) again."""
    return {app["class"] for app in sp["apps"]
            if app["class"] and not app.get("detached")}


def on_special_addresses(sp_id: str) -> set[str]:
    return {str(c.get("address") or "") for c in clients()
            if c.get("mapped", True)
            and str((c.get("workspace") or {}).get("name") or "") == f"special:{sp_id}"}


def plan_claim(sp: dict, clients_list: list[dict], known: set[str]) -> list[dict]:
    """Which live windows belong to this scratchpad's launch and still need
    claiming: class matches an expected app, the address was unknown before
    our launch (so pre-existing desktop windows are never touched), and the
    window is not on a special workspace already. Pure; tests pin it."""
    expected = expected_classes(sp)
    special_prefix = "special:"
    out = []
    for client in clients_list:
        if not client.get("mapped", True):
            continue
        address = str(client.get("address") or "")
        cls = str(client.get("class") or "")
        if address in known or cls not in expected:
            continue
        if str((client.get("workspace") or {}).get("name") or "").startswith(special_prefix):
            continue
        out.append(client)
    return out


def reveal(sp: dict) -> None:
    """The show path without class-global rules.

    Old design (removed): generated o.window rules routed EVERY window of
    a managed class into the special workspace - once an app was in a
    scratchpad, fresh launches after the user killed it were captured
    forever and the app could not be used normally outside.

    New design: a normal launch is a normal window. The toggle claims its
    own windows per launch: launch_missing spawns the app, a background
    claim-wait polls for the new windows and moves each one onto the
    special (silent), then reflow lays them into their slots. The reveal
    happens immediately so the chord feels instant; slow starters are
    claimed as they map, within the claim deadline. Anything that maps
    after the deadline stays a normal window - never trapped."""
    known = {str(c.get("address") or "") for c in clients()}
    launch_missing(sp)
    spawn_claim_wait(sp["id"], known)
    dispatch_lua(f'hl.dsp.workspace.toggle_special({lua_quote(sp["id"])})')
    if sp["placement"] == "slots":
        reflow(sp["id"], quiet=True)


def spawn_claim_wait(sp_id: str, known: set[str], timeout: int = 15) -> None:
    payload = json.dumps({"id": sp_id, "known": sorted(known), "timeout": timeout})
    helper = helper_abs_path()
    subprocess.Popen(
        ["bash", "-c", shlex.quote(helper) + " claim-wait " + shlex.quote(payload)],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def cmd_claim_wait(argv: list[str]) -> None:
    payload = json.loads(argv[2])
    sp_id = payload["id"]
    known = set(payload.get("known") or [])
    deadline = time.monotonic() + float(payload.get("timeout") or 15)
    state = load_state()
    sp = find_sp(state, sp_id)
    if sp is None:
        return
    expected = expected_classes(sp)
    while time.monotonic() < deadline:
        state = load_state()
        sp = find_sp(state, sp_id)
        if sp is None:
            return
        expected = expected_classes(sp)
        for client in plan_claim(sp, clients(), known):
            dispatch_lua(
                f'hl.dsp.window.move({{ window = {lua_quote("address:" + str(client.get("address")))}, '
                f'workspace = {lua_quote("special:" + sp_id)} , follow = false }})'
            )
        on_special = classes_on_special(sp_id)
        if expected and expected.issubset(on_special):
            break
        time.sleep(0.3)
    reflow(sp_id, quiet=True)


def launch_missing(sp: dict) -> None:
    # Launch every non-detached app whose class is not already represented
    # on this scratchpad's special workspace. A window of the same class
    # living in the user's regular workspaces is NOT this scratchpad's
    # copy and is never touched (single-instance apps are the exception:
    # any instance counts, so launchers that exit immediately still work).
    on_special = classes_on_special(sp["id"])
    have_anywhere = window_classes()
    for app in sp["apps"]:
        if not app["command"] or app.get("detached"):
            continue
        if app["class"] and app["class"] in on_special:
            continue
        if app["class"] and app["singleInstance"] and app["class"] in have_anywhere:
            continue
        command = app["command"]
        if shutil.which("uwsm-app"):
            argv = ["uwsm-app", "--", "sh", "-c", command]
        else:
            argv = ["sh", "-c", command]
        subprocess.Popen(
            argv,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )


def toggle(sp_id: str) -> None:
    state = load_state()
    sp = find_sp(state, sp_id)
    if sp is None:
        die(f"unknown scratchpad: {sp_id}")
    shown = special_is_shown(sp_id)
    if not shown:
        reveal(sp)
    else:
        # Already on screen: the chord means "hide". Relaunching missing apps
        # while visible would toggle us closed, so only the hide happens.
        dispatch_lua(f'hl.dsp.workspace.toggle_special({lua_quote(sp_id)})')


def show(sp_id: str) -> None:
    state = load_state()
    sp = find_sp(state, sp_id)
    if sp is None:
        die(f"unknown scratchpad: {sp_id}")
    if special_is_shown(sp_id):
        return
    reveal(sp)


def hide(sp_id: str) -> None:
    if not special_is_shown(sp_id):
        return
    dispatch_lua(f'hl.dsp.workspace.toggle_special({lua_quote(sp_id)})')


# ------------------------------------------------------- config generation

def bind_signature(chord: str) -> tuple[int, str] | None:
    """Order-independent identity of a chord: (modmask, KEY). 'ALT + SUPER
    + B' and 'SUPER + ALT + B' are the same bind to Hyprland."""
    mask = chord_modmask(chord)
    key = chord_key(chord)
    if mask is None or not key:
        return None
    return (mask, key.upper())


def eject_chord(keybind: str) -> str | None:
    """The eject chord for a scratchpad, following Omarchy's built-in
    SUPER+S -> SUPER+ALT+S pattern: the toggle chord with ALT added.
    Chords that already contain ALT are skipped - there is no clean way
    to add ALT twice, and the CLI command still exists for those."""
    parts = [p.strip().upper() for p in str(keybind or "").split("+")]
    if len(parts) < 2 or "ALT" in parts[:-1]:
        return None
    return "ALT + " + str(keybind).strip()


def generate_lua(state: dict, helper_path: str, monitor: dict,
                 taken: set | None = None) -> str:
    """The plugin-owned ~/.config/hypr/scratchpad-studio.lua. Fully rewritten
    on every apply; contains only keybinds (plus the studio's own window
    rule) derived from state.

    Deliberately NO per-app o.window rules: a class-global workspace or
    placement rule would capture every window of that class - fresh
    launches outside the scratchpad included - and hijack their geometry.
    Scratchpad windows are claimed per launch by the helper (claim-wait)
    and placed with dispatchers instead. `taken` carries (modmask, KEY)
    signatures of existing binds: an eject bind that would collide with a
    bind we do not own (an Omarchy default, for instance) is skipped."""
    taken = set(taken or set())
    lines = [
        "-- scratchpad-studio: managed by the Scratchpad Studio plugin.",
        "-- Regenerated from ~/.config/scratchpad-studio/scratchpads.json —",
        "-- edit scratchpads in the GUI, never here.",
        "",
    ]
    # The studio's own app window (class org.quickshell) floats at a sane
    # size; Hyprland would otherwise tile it into the current workspace.
    lines.append(
        'o.window({ class = "^org.quickshell$", title = "^Scratchpad Studio$" }, '
        '{ float = true, size = "1040 700" })'
    )
    lines.append("")
    if not state["scratchpads"]:
        lines.append("-- (no scratchpads configured)")
        lines.append("")
    for sp in state["scratchpads"]:
        lines.append(f"-- {sp['name']} ({sp['id']})")
        if sp["keybind"]:
            command = f"{helper_path} toggle {sp['id']}"
            sig = bind_signature(sp["keybind"])
            if sig is not None and sig in taken:
                lines.append(f"-- toggle chord {sp['keybind']} skipped: already bound")
            else:
                lines.append(
                    f"o.bind({lua_quote(sp['keybind'])}, {lua_quote('Scratchpad: ' + sp['name'])}, "
                    f"{lua_quote(command)})"
                )
                if sig is not None:
                    taken.add(sig)
            eject = eject_chord(sp["keybind"])
            eject_sig = bind_signature(eject) if eject else None
            if eject and eject_sig is not None and eject_sig not in taken:
                lines.append(
                    f"o.bind({lua_quote(eject)}, {lua_quote('Scratchpad eject: ' + sp['name'])}, "
                    f"{lua_quote(helper_path + ' eject --from ' + sp['id'])})"
                )
                taken.add(eject_sig)
        lines.append("")
    return "\n".join(lines)


def helper_abs_path() -> str:
    return str(Path(__file__).resolve())


def atomic_write(path: Path, content: str, mode: int = 0o644) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(content)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def backup_file(path: Path, tag: str) -> Path | None:
    if not path.exists():
        return None
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    BACKUP_DIR.mkdir(parents=True, exist_ok=True)
    target = BACKUP_DIR / f"{tag}-{stamp}-{path.name}"
    # Keep uniqueness even within one second.
    suffix = 0
    while target.exists():
        suffix += 1
        target = BACKUP_DIR / f"{tag}-{stamp}-{suffix}-{path.name}"
    shutil.copy2(path, target)
    return target


def ensure_block(content: str) -> str:
    """Insert/replace the managed require block in bindings.lua content.
    Idempotent; refuses nothing — the block is always exactly BLOCK_LINES."""
    if BLOCK_BEGIN in content and BLOCK_END in content:
        before, rest = content.split(BLOCK_BEGIN, 1)
        _, after = rest.split(BLOCK_END, 1)
    else:
        # Append at the end, separated by a blank line.
        before = content if content.endswith("\n") or content == "" else content + "\n"
        if before != "" and not before.endswith("\n\n"):
            before += "\n"
        after = ""
    block = "\n".join(BLOCK_LINES) + "\n"
    if after.startswith("\n"):
        after = after[1:]
    return before + block + after


def remove_block(content: str) -> str:
    if BLOCK_BEGIN not in content:
        return content
    before, rest = content.split(BLOCK_BEGIN, 1)
    if BLOCK_END not in rest:
        raise RuntimeError("managed block is missing its end marker; refusing to edit")
    _, after = rest.split(BLOCK_END, 1)
    if after.startswith("\n"):
        after = after[1:]
    # Trim a doubled blank line left behind at the seam.
    if before.endswith("\n\n") and after.strip() == "":
        before = before[:-1]
    return before + after


def config_errors() -> str:
    result = subprocess.run(["hyprctl", "configerrors"], capture_output=True, text=True, timeout=10)
    return (result.stdout + result.stderr).strip()


def live_bind_signatures() -> set:
    """(modmask, KEY) signatures of live binds this plugin does not generate
    - the reservation set for auto-generated eject binds."""
    try:
        binds = filter_managed_binds(hyprctl_json(["-j", "binds"]))
    except (SystemExit, json.JSONDecodeError, ValueError):
        return set()
    sigs = set()
    for b in binds:
        mask = b.get("modmask")
        key = str(b.get("key") or "").upper()
        if mask is None or not key:
            continue
        try:
            sigs.add((int(mask), key))
        except (TypeError, ValueError):
            continue
    return sigs


def apply(quiet: bool = False) -> None:
    state = load_state()
    monitor = focused_monitor()
    # Existing binds we do not own (Omarchy defaults, other tools) are
    # reserved: auto-generated eject binds skip chords that would collide
    # with them. Our own binds are regenerated, so they stay available.
    taken = live_bind_signatures()
    lua = generate_lua(state, helper_abs_path(), monitor, taken)

    # Back up before every write; restore both if the reload rejects them.
    backup_file(GENERATED_LUA, "apply")
    old_generated = GENERATED_LUA.read_text() if GENERATED_LUA.exists() else None
    atomic_write(GENERATED_LUA, lua)

    bindings = BINDINGS_LUA.read_text() if BINDINGS_LUA.exists() else ""
    if bindings != ensure_block(bindings):
        backup_file(BINDINGS_LUA, "apply")
        old_bindings = bindings
        atomic_write(BINDINGS_LUA, ensure_block(bindings))
    else:
        old_bindings = None

    subprocess.run(["hyprctl", "reload"], capture_output=True, text=True, timeout=10)
    time.sleep(0.3)
    errors = config_errors()
    if "scratchpad-studio" in errors:
        if old_generated is None:
            GENERATED_LUA.unlink(missing_ok=True)
        else:
            atomic_write(GENERATED_LUA, old_generated)
        if old_bindings is not None:
            atomic_write(BINDINGS_LUA, old_bindings)
        subprocess.run(["hyprctl", "reload"], capture_output=True, timeout=10)
        die(f"config rejected by Hyprland, rolled back: {errors}")
    if not quiet:
        print(f"applied {len(state['scratchpads'])} scratchpad(s)")


def move_windows_out(sp_id: str) -> int:
    """Move the scratchpad's windows to the focused workspace (never kill).
    Returns how many windows were moved."""
    name = f"special:{sp_id}"
    active = hyprctl_json(["activeworkspace"])
    target_ws = str(active.get("name") or "")
    if target_ws == "" or target_ws.startswith("special:"):
        target_ws = str(active.get("id") or "1")
    moved = 0
    for client in clients():
        if str(client.get("workspace", {}).get("name") or "") != name:
            continue
        address = client.get("address")
        if not address:
            continue
        # window dispatchers need the keybind context too: via eval the
        # move silently no-ops (verified live) — dispatch moves it.
        dispatch_lua(
            f'hl.dsp.window.move({{ window = {lua_quote("address:" + address)}, '
            f'workspace = {lua_quote(target_ws)}, follow = false }})'
        )
        moved += 1
    return moved


def move_class_out(sp_id: str, cls: str) -> int:
    """Move only the windows of one class off the special to the current
    workspace. Used when an app is removed from a scratchpad: the rule for
    its class is gone after the next apply, so leaving the window parked on
    the (now foreign) special would be confusing. Same never-kill rule as
    delete: the window stays open, just on the user's workspace."""
    name = f"special:{sp_id}"
    active = hyprctl_json(["activeworkspace"])
    target_ws = str(active.get("name") or "")
    if target_ws == "" or target_ws.startswith("special:"):
        target_ws = str(active.get("id") or "1")
    moved = 0
    for client in clients():
        if str(client.get("workspace", {}).get("name") or "") != name:
            continue
        if str(client.get("class") or "") != cls:
            continue
        address = client.get("address")
        if not address:
            continue
        dispatch_lua(
            f'hl.dsp.window.move({{ window = {lua_quote("address:" + address)}, '
            f'workspace = {lua_quote(target_ws)}, follow = false }})'
        )
        moved += 1
    return moved


def removed_classes(old_sp: dict, new_sp: dict) -> list[str]:
    """Classes configured on the old scratchpad but gone from the new one —
    order-preserving; duplicates collapse. Their windows get relocated on
    save (see move_class_out)."""
    kept = {a["class"] for a in new_sp["apps"]}
    out: list[str] = []
    for app in old_sp["apps"]:
        cls = app["class"]
        if cls and cls not in kept and cls not in out:
            out.append(cls)
    return out


def scratchpad_chord_owners(state: dict, chord: str, exclude_id: str | None) -> list[dict]:
    """Scratchpads (other than the one being edited) already holding this
    exact chord. State is authoritative here, not the live-bind list: a
    long-running shell caches binds from startup, so a freshly created
    scratchpad's chord would look free until the next restart."""
    if not chord:
        return []
    return [
        {"id": s["id"], "name": s["name"]}
        for s in state["scratchpads"]
        if s["id"] != exclude_id and s["keybind"] and s["keybind"] == chord
    ]


# Pixel dispatch, verified live on Hyprland 0.56.2 (Lua config) with a
# disposable foot window parked on a hidden special:
#   hl.dsp.window.move({ window = ..., x = N, y = N })   absolute px move
#   hl.dsp.window.resize({ window = ..., x = W, y = H })  x/y mean SIZE —
#     and it is center-anchored, so resize FIRST, then move to the final
#     corner. Both apply to windows on hidden special workspaces; the next
#     reveal shows the new geometry (that is what makes edit-while-hidden
#     reflow work).
def resize_window_pixels(address: str, w: int, h: int) -> None:
    dispatch_lua(
        f'hl.dsp.window.resize({{ window = {lua_quote("address:" + address)}, '
        f'x = {int(w)}, y = {int(h)} }})'
    )


def move_window_pixels(address: str, x: int, y: int) -> None:
    dispatch_lua(
        f'hl.dsp.window.move({{ window = {lua_quote("address:" + address)}, '
        f'x = {int(x)}, y = {int(y)} }})'
    )


def plan_reflow(sp: dict, usable: tuple[int, int], live_clients: list) -> list:
    """Which live windows should land in which slot rect: [{address, class,
    rect}]. Pure so tests can pin it. Floating placement pins nothing (the
    whole point is that the window keeps its own size and position).
    Several windows of one class all get their app's slot (a "single"/
    "stacked" scratchpad overlays them exactly like the rules would)."""
    if sp["placement"] != "slots":
        return []
    special = f"special:{sp['id']}"
    on_special = [
        c for c in live_clients
        if c.get("mapped", True)
        and str(c.get("workspace", {}).get("name") or "") == special
    ]
    rects = layout_rects(sp, usable)
    class_rects: dict[str, list] = {}
    for app, rect in zip(sp["apps"], rects):
        if app["class"]:
            class_rects.setdefault(app["class"], []).append(rect)
    plans = []
    seen: dict[str, int] = {}
    for client in on_special:
        cls = str(client.get("class") or "")
        if cls not in class_rects:
            continue
        address = str(client.get("address") or "")
        if not address:
            continue
        i = seen.get(cls, 0)
        seen[cls] = i + 1
        plans.append({
            "address": address,
            "class": cls,
            "rect": class_rects[cls][min(i, len(class_rects[cls]) - 1)],
            # Windows that mapped before a rule applied (or drifted) can be
            # tiled on the special; pixel moves only reach floating windows
            # (verified live), so reflow floats them first — which is also
            # the state the scratchpad's own rules intend.
            "floating": bool(client.get("floating")),
        })
    return plans


def float_window(address: str) -> None:
    dispatch_lua(
        f'hl.dsp.window.float({{ window = {lua_quote("address:" + address)} }})'
    )


def reflow(sp_id: str, quiet: bool = False) -> None:
    """Nudge already-open scratchpad windows onto their configured slots.
    Window rules only fire at map time, so without this an edit to the
    layout would not affect windows that are already open (verified live).
    Works while the special is hidden — the next reveal shows the new
    arrangement."""
    state = load_state()
    sp = find_sp(state, sp_id)
    if sp is None:
        die(f"unknown scratchpad: {sp_id}")
    monitor = focused_monitor()
    plans = plan_reflow(sp, usable_area(monitor), clients())
    for plan in plans:
        if not plan["floating"]:
            float_window(plan["address"])
        x, y, w, h = plan["rect"]
        resize_window_pixels(plan["address"], w, h)  # center-anchored: first
        move_window_pixels(plan["address"], x, y)    # then to the corner
    if not quiet:
        print(f"reflowed {len(plans)} window(s) on {sp_id}")


def delete(sp_id: str, keep_windows: bool) -> None:
    state = load_state()
    sp = find_sp(state, sp_id)
    if sp is None:
        die(f"unknown scratchpad: {sp_id}")
    if not keep_windows:
        moved = move_windows_out(sp_id)
    else:
        moved = 0
    state["scratchpads"] = [s for s in state["scratchpads"] if s["id"] != sp_id]
    save_state(state)
    apply(quiet=True)
    print(f"deleted {sp_id} ({moved} window(s) moved to the current workspace)")


def adopt(sp_id: str, name: str | None) -> None:
    state = load_state()
    if find_sp(state, sp_id):
        die(f"already managed: {sp_id}")
    if sp_id in RESERVED_SPECIALS:
        die("special:scratchpad is Omarchy's built-in (SUPER+S); adopting "
            "would rewrite its rules — create a scratchpad with a "
            "different name instead")
    live = [str(ws.get("name") or "") for ws in workspaces()]
    if f"special:{sp_id}" not in live:
        die(f"no such special workspace: special:{sp_id}")
    state["scratchpads"].append(normalize_sp({
        "id": sp_id,
        "name": name or sp_id.replace("-", " ").replace("_", " ").title(),
        "icon": "",
        "keybind": "",
        "anchor": "top",
        "layout": "single",
        "transition": "down",
        "sizePct": {"w": 60, "h": 50},
        "marginPx": 12,
        "apps": [],
    }))
    save_state(state)
    apply(quiet=True)
    print(f"adopted special:{sp_id}")


def install() -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    if not STATE_PATH.exists():
        save_state(default_state())
    apply()


def uninstall(purge: bool) -> None:
    backup_file(BINDINGS_LUA, "uninstall")
    if BINDINGS_LUA.exists():
        content = BINDINGS_LUA.read_text()
        if BLOCK_BEGIN in content:
            atomic_write(BINDINGS_LUA, remove_block(content))
    GENERATED_LUA.unlink(missing_ok=True)
    subprocess.run(["hyprctl", "reload"], capture_output=True, timeout=10)
    if purge:
        shutil.rmtree(STATE_DIR, ignore_errors=True)
        print("uninstalled; state removed")
    else:
        print("uninstalled; state kept at", STATE_PATH)


# ------------------------------------------------------- keybind conflicts

MOD_BITS = [
    (1, "SHIFT"), (2, "CAPS"), (4, "CTRL"), (8, "ALT"),
    (16, "MOD2"), (32, "MOD3"), (64, "SUPER"), (128, "MOD5"),
]
KNOWN_MODS = {name for _, name in MOD_BITS}


def chord_modmask(chord: str) -> int | None:
    """'ALT + SUPER + P' -> 72. None when the chord is malformed."""
    parts = [p.strip() for p in str(chord or "").split("+")]
    if not parts or any(p == "" for p in parts):
        return None
    key = parts[-1]
    mods = parts[:-1]
    mask = 0
    for mod in mods:
        name = mod.upper()
        if name not in KNOWN_MODS:
            return None
        bit = next(b for b, n in MOD_BITS if n == name)
        mask |= bit
    if len(key) == 0:
        return None
    return mask


def chord_key(chord: str) -> str:
    return str(chord or "").split("+")[-1].strip()


def find_bind_conflict(chord: str, binds: list) -> dict | None:
    mask = chord_modmask(chord)
    key = chord_key(chord)
    if mask is None:
        return None
    for bind in binds:
        if bind.get("keycode"):
            continue  # keycode binds can't collide with named keys
        if bind.get("modmask") == mask and str(bind.get("key") or "") == key:
            return bind
    return None


def scan_config_chords(files: dict) -> list:
    """Textual scan of hypr config files for o.bind/hl.bind chords. Skips our
    own managed block. Returns [(chord, filename), ...]."""
    hits = []
    for name, content in files.items():
        if self_marker(content):
            content = strip_managed(content)
        for line in content.splitlines():
            stripped = line.strip()
            if not (stripped.startswith("o.bind(") or stripped.startswith("hl.bind(")):
                continue
            first = stripped.split("(", 1)[1].split(",", 1)[0].strip().strip("'\"")
            if first:
                hits.append((first, name))
    return hits


def self_marker(content: str) -> bool:
    return BLOCK_BEGIN in content


def strip_managed(content: str) -> str:
    if BLOCK_BEGIN not in content:
        return content
    before, rest = content.split(BLOCK_BEGIN, 1)
    if BLOCK_END not in rest:
        return content
    _, after = rest.split(BLOCK_END, 1)
    return before + after


def self_bind_match(bind: dict, sp_id: str, sp_name: str) -> bool:
    """Is this live bind the scratchpad's own chord? Our generated binds run
    `<helper> toggle <id>` with description `Scratchpad: <name>`; either
    marker identifies it (the arg is authoritative, the description is the
    fallback for Hyprland builds that report it differently)."""
    arg = str(bind.get("arg") or "")
    if "toggle" in arg and arg.rstrip().endswith(f"toggle {sp_id}"):
        return True
    return str(bind.get("description") or "") == f"Scratchpad: {sp_name}"


def filter_self_binds(binds: list, sp_id: str, sp_name: str) -> list:
    return [b for b in binds if not self_bind_match(b, sp_id, sp_name)]


def managed_bind_descriptions(state: dict) -> set[str]:
    """Descriptions our generated o.bind lines carry right now."""
    return {f"Scratchpad: {s['name']}" for s in state["scratchpads"]}


MANAGED_BIND_PREFIX = "Scratchpad: "


def filter_managed_binds(binds: list) -> list:
    """Drop every bind our generated config owns: this plugin's binds always
    describe themselves with the managed prefix. State ownership
    (scratchpad_chord_owners) decides scratchpad-vs-scratchpad conflicts;
    this only removes our own binds from the live check — including a
    renamed scratchpad's bind, which still carries its old name until the
    next apply (and Hyprland reports our args as numbers, so nothing else
    identifies it)."""
    return [b for b in binds
            if not str(b.get("description") or "").startswith(MANAGED_BIND_PREFIX)]


def cmd_conflicts(chord: str, as_json: bool = False, self_id: str | None = None) -> None:
    import glob
    binds = hyprctl_json(["-j", "binds"])
    state = load_state()
    # Scratchpad chords are decided from state (always current): another
    # scratchpad holding this chord is reported via scratchpadOwners, the
    # scratchpad being edited never conflicts with itself. Every managed
    # bind is dropped from the live list — matching own binds by
    # description failed for renamed scratchpads (the bind still carried
    # the old name), and Hyprland reports our binds' arg as a number.
    binds = filter_managed_binds(binds)
    live = find_bind_conflict(chord, binds)
    # Scratchpads already holding this chord — from state, which is always
    # current (live binds can be stale in a long-running shell).
    owners = scratchpad_chord_owners(state, chord, self_id)
    files = {}
    for pattern in ("bindings*.lua", "*.lua"):
        for path in sorted(set(glob.glob(str(HYPR_DIR / pattern)))):
            # Our own generated file holds every scratchpad's current o.bind
            # by definition — counting it made pressing a scratchpad's own
            # chord report a phantom "used in your config" conflict.
            if Path(path).name == GENERATED_LUA.name:
                continue
            files[Path(path).name] = Path(path).read_text()
    config_hits = [hit for hit in scan_config_chords(files) if hit[0] == chord]
    payload = {
        "chord": chord,
        "valid": chord_modmask(chord) is not None,
        "liveBind": live,
        "scratchpadOwners": owners,
        "configLines": config_hits,
    }
    if as_json:
        print(json.dumps(payload))
    else:
        print(json.dumps(payload, indent=2))


def cmd_binds_json() -> str:
    """Slim live-bind list for suggestion math: [{modmask, key, description}]."""
    binds = hyprctl_json(["-j", "binds"])
    slim = [
        {"modmask": b.get("modmask", 0), "key": b.get("key", ""),
         "description": b.get("description", "")}
        for b in binds
    ]
    print(json.dumps(slim))


# ------------------------------------------------------- window capture

def live_windows() -> list[dict]:
    """Mappable windows for the capture picker: regular workspaces only,
    studio window excluded. Carries the address so the GUI can capture an
    exact window, not just a class."""
    out = []
    for client in clients():
        if not client.get("mapped", True):
            continue
        ws = client.get("workspace", {}) or {}
        ws_name = str(ws.get("name") or "")
        if ws_name.startswith("special:"):
            continue
        cls = str(client.get("class") or "")
        if cls == "org.quickshell":
            continue
        out.append({
            "address": str(client.get("address") or ""),
            "class": cls,
            "title": str(client.get("title") or ""),
            "workspace": int(ws.get("id") or 0),
            "floating": bool(client.get("floating")),
        })
    return out


def cmd_eject() -> None:
    """Inverse of capture: move the focused window off its scratchpad
    special workspace to the current workspace and mark its app entry
    detached, so toggle stops re-summoning it. The window stays open and
    fully usable as a normal desktop window. Never closes or kills."""
    focused = None
    try:
        focused = hyprctl_json(["-j", "activewindow"])
    except (json.JSONDecodeError, ValueError):
        focused = None
    focused = None
    try:
        focused = hyprctl_json(["-j", "activewindow"])
    except (json.JSONDecodeError, ValueError):
        focused = None
    # eject targets the opposite of capture: a window ON a special
    # workspace, so the special-resident refusal does not apply here.
    if focused is None or not focused.get("address"):
        die("no focused window")
    target = focused
    address = str(target.get("address") or "")
    ws_name = str((target.get("workspace") or {}).get("name") or "")
    if not ws_name.startswith("special:"):
        die(f"the focused window is not on a scratchpad ({ws_name or 'unknown workspace'})")
    sp_id = ws_name[len("special:"):]
    state = load_state()
    sp = find_sp(state, sp_id)
    if sp is None:
        die(f"{ws_name} is not a managed scratchpad")
    active_ws = hyprctl_json(["activeworkspace"])
    target_ws = str(active_ws.get("name") or "")
    if target_ws == "" or target_ws.startswith("special:"):
        target_ws = str(active_ws.get("id") or "1")
    dispatch_lua(
        f'hl.dsp.window.move({{ window = {lua_quote("address:" + address)}, '
        f'workspace = {lua_quote(target_ws)} , follow = false }})'
    )
    cls = str(target.get("class") or "")
    detached = False
    for app in sp["apps"]:
        if app["class"] == cls and not app.get("detached"):
            app["detached"] = True
            detached = True
            save_state(state)
            apply(quiet=True)
            break
    print(json.dumps({
        "ejected": address,
        "class": cls,
        "from": ws_name,
        "to": target_ws,
        "detached": detached,
    }))


def cmd_windows_json() -> None:
    print(json.dumps(live_windows()))


def select_capture_target(clients_list: list[dict], focused: dict | None,
                          address: str | None, cls: str | None
                          ) -> tuple[dict | None, str | None]:
    """Pick the window a capture should move: --address wins, then
    --class (first match), else the currently focused window. Returns
    (window, None) or (None, reason). Windows already living on a special
    workspace are refused - they are scratchpad residents, not desktop
    windows waiting to be captured."""
    target = None
    if address:
        for client in clients_list:
            if str(client.get("address") or "") == address:
                target = client
                break
        if target is None:
            return None, f"no window with address {address}"
    elif cls:
        for client in clients_list:
            if str(client.get("class") or "") == cls:
                target = client
                break
        if target is None:
            return None, f"no window with class {cls}"
    else:
        target = focused
        if target is None or not target.get("address"):
            return None, "no focused window"
    ws_name = str((target.get("workspace") or {}).get("name") or "")
    if ws_name.startswith("special:"):
        return None, f"window is already on {ws_name}"
    if str(target.get("class") or "") == "org.quickshell":
        return None, "refusing to capture the studio's own window"
    return target, None


def class_owned_by_other(state: dict, cls: str, sp_id: str) -> dict | None:
    """The scratchpad (other than sp_id) already managing this window class,
    if any - two scratchpads with class rules for one class would route
    each other's windows (the shared-workspace lesson, at class level)."""
    for sp in state["scratchpads"]:
        if sp["id"] == sp_id:
            continue
        for app in sp["apps"]:
            if app["class"] == cls:
                return sp
    return None


def build_captured_app(client: dict, catalogue: list[dict]) -> dict:
    """App-list entry for a captured window: catalogue match by window
    class gives the real name/launch command and the single-instance
    detection (same source as the wizard's picker); without a desktop
    entry the class is all we know, and the window itself is already in
    the scratchpad, so an empty command is honest."""
    cls = str(client.get("class") or "")
    title = str(client.get("title") or "")
    for entry in catalogue:
        if entry.get("wmClass") == cls:
            return {
                "name": str(entry.get("name") or cls),
                "command": str(entry.get("command") or ""),
                "class": cls,
                "webapp": bool(entry.get("webapp")),
                "singleInstance": bool(entry.get("singleInstance")),
            }
    return {
        "name": (title.split(" ")[0][:24] or cls),
        "command": "",
        "class": cls,
        "webapp": cls.startswith("chrome-"),
        "singleInstance": cls.lower() in SINGLE_INSTANCE_CLASSES,
    }


# ---------------------------------------------------------------- commands

def shown_specials() -> set[str]:
    """Ids of special workspaces currently revealed on any monitor."""
    out = set()
    for monitor in monitors():
        special = monitor.get("specialWorkspace") or {}
        name = str(special.get("name") or "")
        if name.startswith("special:"):
            out.add(name[len("special:"):])
    return out


def cmd_list() -> None:
    state = load_state()
    shown = shown_specials()
    classes = window_classes()
    out = []
    for sp in state["scratchpads"]:
        windows = [
            {"class": str(c.get("class") or ""), "title": str(c.get("title") or "")}
            for c in clients()
            if c.get("workspace", {}).get("name") == f"special:{sp['id']}"
        ]
        out.append({
            **sp,
            "status": "shown" if sp["id"] in shown else ("running" if windows else "idle"),
            "windows": windows,
        })
    print(json.dumps({"version": state["version"], "scratchpads": out}, indent=2))


def cmd_geometry(sp_id: str) -> None:
    state = load_state()
    sp = find_sp(state, sp_id)
    if sp is None:
        die(f"unknown scratchpad: {sp_id}")
    monitor = focused_monitor()
    print(json.dumps({
        "monitor": monitor.get("name"),
        "usable": usable_area(monitor),
        "rects": layout_rects(sp, usable_area(monitor)),
    }, indent=2))


def main(argv: list[str]) -> None:
    if len(argv) < 2:
        print(__doc__)
        sys.exit(2)
    command = argv[1]
    if command == "list":
        cmd_list()
    elif command == "toggle" and len(argv) == 3:
        toggle(argv[2])
    elif command == "show" and len(argv) == 3:
        show(argv[2])
    elif command == "hide" and len(argv) == 3:
        hide(argv[2])
    elif command == "geometry" and len(argv) == 3:
        cmd_geometry(argv[2])
    elif command == "shown":
        print(json.dumps(sorted(shown_specials())))
    elif command == "apply":
        apply()
    elif command == "reflow" and len(argv) == 3:
        reflow(argv[2])
    elif command == "delete" and len(argv) >= 3:
        delete(argv[2], "--keep" in argv)
    elif command == "adopt" and len(argv) >= 3:
        name = None
        if "--name" in argv and argv.index("--name") + 1 < len(argv):
            name = argv[argv.index("--name") + 1]
        adopt(argv[2], name)
    elif command == "install":
        install()
    elif command == "uninstall":
        uninstall("--purge" in argv)
    elif command == "conflicts" and len(argv) >= 3:
        cmd_conflicts(argv[2], self_id=flag_value(argv, "--self"))
    elif command == "conflicts-json" and len(argv) >= 3:
        cmd_conflicts(argv[2], as_json=True, self_id=flag_value(argv, "--self"))
    elif command == "binds-json":
        cmd_binds_json()
    elif command == "capture" and len(argv) >= 3:
        cmd_capture(argv)
    elif command == "eject":
        cmd_eject()
    elif command == "claim-wait" and len(argv) >= 3:
        cmd_claim_wait(argv)
    elif command == "windows-json":
        cmd_windows_json()
    elif command == "apps":
        cmd_apps()
    elif command == "upsert":
        cmd_upsert(argv)
    elif command == "state-path":
        print(STATE_PATH)
    elif command == "version":
        print(VERSION)
    else:
        print(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv)
